================================================================================
                                       INPUT FILE
================================================================================
NAME = .\nitroxide.inp
|  1> ! B3LYP EPR-II

|  2> *xyzfile 0 2 nitroxide_opt.xyz

|  3> %eprnmr

|  4>   gtensor 1

|  5>   Nuclei = all H {aiso, adip, aorb, fgrad, rho}

|  6>   Nuclei = all C {aiso, adip, aorb, fgrad, rho}

|  7>   Nuclei = all N {aiso, adip, aorb, fgrad, rho}

|  8>   Nuclei = all O {aiso, adip, aorb, fgrad, rho}

|  9> end

| 10> 
| 11>                          ****END OF INPUT****
