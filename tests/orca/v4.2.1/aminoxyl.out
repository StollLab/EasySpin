|  5>   Nuclei = all H {aiso, adip, aorb, fgrad, rho}

|  6>   Nuclei = all N {aiso, adip, aorb, fgrad, rho}

|  7>   Nuclei = all O {aiso, adip, aorb, fgrad, rho}

|  8> end

